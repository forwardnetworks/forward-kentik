{
  "name": "forward-kentik",
  "version": "0.1.3",
  "description": "Forward field integration for turning Kentik flow evidence into Forward intent-check packages",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forwardnetworks/forward-kentik.git"
  },
  "bugs": {
    "url": "https://github.com/forwardnetworks/forward-kentik/issues"
  },
  "homepage": "https://github.com/forwardnetworks/forward-kentik#readme",
  "scripts": {
    "kentik:export": "node scripts/kentik-export.mjs",
    "kentik:live:smoke": "node scripts/kentik-live-smoke.mjs",
    "kentik:live-or-seed:smoke": "node scripts/kentik-live-or-seed-smoke.mjs",
    "kentik:seed:demo": "node scripts/seed-kentik-demo-data.mjs",
    "forward:import": "node scripts/forward-import-package.mjs",
    "forward:import:smoke": "node scripts/forward-import-smoke.mjs",
    "forward:sign": "node scripts/sign-forward-package.mjs",
    "forward:data-connector": "node scripts/forward-data-connector-config.mjs",
    "forward:location-map": "node scripts/forward-location-map-template.mjs",
    "dashboard:build": "node scripts/build-dashboard.mjs",
    "dashboard:serve": "node scripts/serve-dashboard.mjs",
    "package:serve": "node scripts/serve-package.mjs",
    "screenshots:render": "node scripts/render-demo-screenshots.mjs",
    "screenshots:check": "node scripts/render-demo-screenshots.mjs --check",
    "repo:validate": "node scripts/validate-repo.mjs",
    "github-actions:validate": "node scripts/validate-github-action-pins.mjs",
    "schemas:validate": "node scripts/schema-validate.mjs",
    "workflow:smoke": "node scripts/workflow-smoke.mjs",
    "scale:smoke": "node scripts/scale-smoke.mjs",
    "acceptance:bundle": "node scripts/acceptance-bundle.mjs",
    "release:checksums": "node scripts/release-checksums.mjs",
    "release:package": "node scripts/package-release-artifacts.mjs",
    "release:package:smoke": "node scripts/package-release-artifacts.mjs",
    "release:sign": "node scripts/sign-release-checksums.mjs",
    "release:signing-key:generate": "node scripts/generate-release-signing-keypair.mjs",
    "release:ref:validate": "node scripts/validate-release-ref.mjs",
    "security:audit": "npm audit --audit-level=high",
    "sbom:check": "npm sbom --sbom-format=cyclonedx > /tmp/forward-kentik-sbom.cdx.json",
    "whitespace:check": "git diff --check",
    "lint": "eslint .",
    "test": "node --test test/*.test.mjs",
    "ci": "npm run repo:validate && npm run github-actions:validate && npm run whitespace:check && npm run kentik:export && npm run schemas:validate && npm run dashboard:build && npm run screenshots:check && npm test && npm run workflow:smoke && npm run forward:import:smoke && npm run scale:smoke && npm run acceptance:bundle && npm run release:package:smoke && npm run security:audit && npm run sbom:check && npm run lint"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "author": "Forward Networks",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-n": "^18.2.1",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-security": "^4.0.1"
  }
}
