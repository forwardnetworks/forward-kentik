# Non-secret runtime settings.
FORWARD_KENTIK_PACKAGE_URL=https://package.example.com/forward-kentik/latest/
FORWARD_KENTIK_REPORT_PATH=/var/lib/forward-kentik/forward-import-report.json
FORWARD_KENTIK_METRICS_PATH=/var/lib/forward-kentik/forward-import-metrics.prom
FORWARD_KENTIK_STATUS_PATH=/var/lib/forward-kentik/forward-ingest-status.json
FORWARD_KENTIK_MAX_PACKAGE_AGE_MINUTES=1440

# Secrets. Prefer an OS/runtime secret store over a plain env file.
FORWARD_BASE_URL=https://forward.example.com
FORWARD_USER=<user>
FORWARD_PASSWORD=<password-or-token>
FORWARD_NETWORK_ID=<network-id>
